# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Models ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Embeddings for the contract RAG index. Required at import time, so the app
# will not start without it: https://dashboard.voyageai.com/organization/api-keys
VOYAGE_API_KEY=pa-...

# ── Database ────────────────────────────────────────────────────────────────
# Owner role — seeding only. Note port 5433: the salespilot-pg container
# publishes 5433 on the host and maps it to 5432 inside.
DATABASE_URL=postgresql://salespilot:salespilot@localhost:5433/salespilot

# Read-only role the SQL agent runs as. Never point this at the owner.
SQL_AGENT_DATABASE_URL=postgresql://sp_readonly:readonly@localhost:5433/salespilot

# Optional. Used only when the API runs inside docker compose, where
# "localhost" would resolve to the container itself. Leave unset to accept the
# default in docker-compose.yml.
# SQL_AGENT_DATABASE_URL_DOCKER=postgresql://sp_readonly:readonly@host.docker.internal:5433/salespilot

# ── Tracing ─────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Grafana ─────────────────────────────────────────────────────────────────
# Admin login for the local Grafana at http://127.0.0.1:3000.
# docker compose fails fast if either is missing.
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Shared secret between Grafana and the image-renderer container. Any random
# string; Grafana refuses to start in production mode with the default value.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_RENDERER_TOKEN=change-me
