{
  "uid": "salespilot-overview",
  "title": "SalesPilot — agent health & cost",
  "description": "Aggregate view. For a single request's trace, use Langfuse instead.",
  "tags": ["salespilot", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cost per question",
      "description": "Total LLM spend divided by questions answered. orchestrator runs exactly once per question, so its execution count is the question count.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(llm_cost_usd_total[$__range])) / clamp_min(sum(increase(agent_requests_total{agent=\"orchestrator\"}[$__range])), 1)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 4, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Spend over range",
      "description": "Total estimated Anthropic spend across the selected time range. Voyage embedding cost is not included.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(llm_cost_usd_total[$__range]))", "instant": true }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 3, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Refusal rate",
      "description": "Share of answers that declined for lack of supporting sources. This is designed behaviour — a sustained rise means coverage or retrieval quality has degraded, not that the system is broken.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(refusals_total[$__range])) / clamp_min(sum(increase(agent_requests_total{agent=\"synthesis\"}[$__range])), 1)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#D96C0A", "value": 0.4 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Questions answered",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(agent_requests_total{agent=\"orchestrator\"}[$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "P95 latency by agent",
      "description": "Which of the four steps is the bottleneck. Buckets run to 34s, so a flat line at the top means saturation rather than a real value.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (agent, le) (rate(agent_duration_seconds_bucket[5m])))",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "orchestrator" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3274D9" } }] },
          { "matcher": { "id": "byName", "options": "sql_agent" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#56A64B" } }] },
          { "matcher": { "id": "byName", "options": "rag_agent" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#A352CC" } }] },
          { "matcher": { "id": "byName", "options": "synthesis" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D96C0A" } }] }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Where the time actually goes",
      "description": "Share of each agent's wall-clock spent in its non-LLM inner block. Low database share means optimising SQL or indexes will not help — the time is in generating the query. Retrieval share is dominated by the Voyage embedding round-trip, not the vector search.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sql_query_duration_seconds_sum[5m])) / clamp_min(sum(rate(agent_duration_seconds_sum{agent=\"sql_agent\"}[5m])), 0.001)",
          "legendFormat": "sql_agent — database"
        },
        {
          "refId": "B",
          "expr": "sum(rate(retrieval_duration_seconds_sum[5m])) / clamp_min(sum(rate(agent_duration_seconds_sum{agent=\"rag_agent\"}[5m])), 0.001)",
          "legendFormat": "rag_agent — retrieval"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "sql_agent — database" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#56A64B" } }] },
          { "matcher": { "id": "byName", "options": "rag_agent — retrieval" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#A352CC" } }] }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "id": 7,
      "type": "bargauge",
      "title": "Input / output token ratio by agent",
      "description": "How many input tokens each agent burns per output token. A high ratio on a fixed system prompt is the signal for prompt caching.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (increase(llm_tokens_total{type=\"input\"}[$__range])) / clamp_min(sum by (agent) (increase(llm_tokens_total{type=\"output\"}[$__range])), 1)",
          "legendFormat": "{{agent}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 1, "min": 0, "color": { "mode": "fixed", "fixedColor": "#3274D9" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "orchestrator" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3274D9" } }] },
          { "matcher": { "id": "byName", "options": "sql_agent" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#56A64B" } }] },
          { "matcher": { "id": "byName", "options": "synthesis" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D96C0A" } }] }
        ]
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Spend rate by agent",
      "description": "Projected USD per hour at the current rate. Sums to the burn rate the SpendRateHigh alert watches.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (rate(llm_cost_usd_total[5m])) * 3600",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "orchestrator" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3274D9" } }] },
          { "matcher": { "id": "byName", "options": "sql_agent" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#56A64B" } }] },
          { "matcher": { "id": "byName", "options": "synthesis" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D96C0A" } }] }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "Executions and failures by agent",
      "description": "Node executions per second. Failures are drawn from agent_errors_total; a persistent non-zero line is worth pairing with the error_type label in Prometheus.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (rate(agent_requests_total[5m]))",
          "legendFormat": "{{agent}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(agent_errors_total[5m]))",
          "legendFormat": "errors (all agents)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "orchestrator" },        "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3274D9" } }] },
          { "matcher": { "id": "byName", "options": "sql_agent" },           "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#56A64B" } }] },
          { "matcher": { "id": "byName", "options": "rag_agent" },           "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#A352CC" } }] },
          { "matcher": { "id": "byName", "options": "synthesis" },           "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D96C0A" } }] },
          {
            "matcher": { "id": "byName", "options": "errors (all agents)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Chunks returned per retrieval",
      "description": "Sits at TOP_K (4) in normal operation. A drop toward zero means the Chroma collection is missing or was built with a different embedding model — re-run ingest_contracts.py --reset.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(retrieval_chunks_sum[5m]) / clamp_min(rate(retrieval_chunks_count[5m]), 0.001)",
          "legendFormat": "chunks per query"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#A352CC" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ]
}
